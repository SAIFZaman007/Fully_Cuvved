# Base URL of the FastAPI backend, including version prefix.
# In local dev, Vite's dev server can also proxy /api to this target — see vite.config.js.
VITE_API_URL=http://localhost:8000/api/v1

# When true, the app runs entirely against realistic in-memory mock data
# (see src/lib/api.js) so the UI can be built and demoed before the backend
# exists. Set to false once the FastAPI backend is deployed and reachable.
VITE_ENABLE_MOCKS=true
